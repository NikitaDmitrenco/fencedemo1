# ─── Канал доставки заявок ──────────────────────────────────────────────
# Заявка уходит во все настроенные каналы. Чтобы ограничить список, задайте
# LEAD_CHANNELS через запятую: telegram,email
LEAD_CHANNELS=

# Telegram — канал по умолчанию. Бот создаётся через @BotFather.
#
# TELEGRAM_CHAT_ID принимает нескольких получателей через запятую: заявка
# уходит каждому. Свой id человек узнаёт у @userinfobot; отрицательный id —
# это группа, она тоже работает как получатель.
#
# Каждый получатель должен один раз нажать Start у бота: боты не могут
# написать первыми тому, кто с ними не заговорил.
#
# Пример: TELEGRAM_CHAT_ID=123456789,987654321
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Адрес Bot API. Нужен только для self-hosted сервера Telegram или для
# прогона доставки на локальном моке; обычно оставляется пустым.
TELEGRAM_API_BASE=

# Почта (resend.com) — запасной или основной канал для клиентов,
# которые не пользуются мессенджерами.
RESEND_API_KEY=
LEAD_EMAIL_TO=
LEAD_EMAIL_FROM=

# ─── Аналитика ──────────────────────────────────────────────────────────
NEXT_PUBLIC_YM_ID=

# ─── Адрес сайта ────────────────────────────────────────────────────────
# Можно не заводить: адрес берётся из VERCEL_PROJECT_PRODUCTION_URL,
# который Vercel подставляет сам.
NEXT_PUBLIC_SITE_URL=
